{
  "$schema": "https://json.schemastore.org/electron-builder.json",
  "appId": "br.com.vixt.barbearia",
  "productName": "VIXT Barbearia",
  "directories": {
    "output": "../dist/barbearia",
    "buildResources": "../build"
  },
  "files": ["src/**/*", "apps/barbearia.config.json"],
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "icon": "vixt-barbearia.ico",
    "artifactName": "vixt-barbearia-${version}-setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "VIXT Barbearia"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "sitesqr",
      "repo": "vixt-platform",
      "releaseType": "release"
    }
  ]
}
