{
  "name": "vixt-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:distributions": "tsx prisma/seed-distributions.ts",
    "db:dev": "prisma migrate dev",
    "buildcmd": "npm install --include=dev && npx prisma generate && npx prisma migrate deploy && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@prisma/client-runtime-utils": "^7.10.1",
    "argon2": "^0.45.2",
    "clsx": "^2.1.1",
    "jose": "^6.2.18",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7",
    "@tailwindcss/turbopack": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "effect": "3.22.5",
    "deepmerge-ts": "8.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
