# ============================================================
# VIXT Central — Variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# ============================================================

# --- Banco de dados (Neon / PostgreSQL) ---
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/vixt_central?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/vixt_central?sslmode=require"

# --- Aplicação ---
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="VIXT"

# --- Autenticação administrativa ---
JWT_SECRET="troque-este-segredo-com-48-bytes-aleatorios"
ADMIN_SESSION_TTL_MINUTES="720"

# --- Bootstrap do primeiro administrador (somente no seed) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador VIXT"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_LOGIN_MAX="5"

# --- Analytics ---
ANALYTICS_SALT="troque-este-salt-aleatorio"

# --- Links de acesso dos aplicativos próprios ---
# Preencha somente para os aplicativos que devem aparecer no catálogo.
# LINK_OFICINA_WEB="https://oficinapro-3akc.onrender.com"
# LINK_BARBEARIA_WEB="https://vixt-barber.onrender.com"
# LINK_BEAUTY_WEB="https://vixt-beauty.onrender.com/"

# --- PWA dos aplicativos (instalação no celular) ---
# URL da PWA de cada aplicativo. Ao preencher, o botão "Baixar no celular (PWA)"
# aparece na página do aplicativo. Gratuito e sem arquivos hospedados na VIXT.
# PWA_OFICINA_URL="https://oficinapro-3akc.onrender.com"
# PWA_BARBEARIA_URL="https://vixt-barber.onrender.com"
# PWA_BEAUTY_URL="https://vixt-beauty.onrender.com/"
