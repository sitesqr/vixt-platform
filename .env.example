# ============================================================
# VIXT Central — Variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# ============================================================

# --- Banco de dados (Neon / PostgreSQL) ---
# Formato: postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/vixt_central?sslmode=require"
# Conexão direta (sem pooler) usada apenas por `prisma migrate deploy`.
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/vixt_central?sslmode=require"

# --- Aplicação ---
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="VIXT"

# --- Autenticação administrativa ---
# Gere com: openssl rand -base64 48
JWT_SECRET="troque-este-segredo-com-48-bytes-aleatorios"
# Sessão admin em minutos (padrão: 720 = 12h)
ADMIN_SESSION_TTL_MINUTES="720"

# --- Bootstrap do primeiro administrador (somente no seed) ---
# O seed SÓ cria o admin se ADMIN_EMAIL e ADMIN_PASSWORD estiverem definidos.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador VIXT"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_LOGIN_MAX="5"

# --- Analytics ---
# Salt para hash de sessão (não é PII; IP bruto nunca é persistido).
ANALYTICS_SALT="troque-este-salt-aleatorio"

# --- Links de distribuição dos aplicativos próprios ---
# Preencha APENAS para os aplicativos que devem aparecer no catálogo.
# Sem link, o aplicativo fica em desenvolvimento e não é exibido ao público.
# Borracharia, Lava Rápido e Salão estão adiados — não preencher ainda.
# LINK_OFICINA_WEB="https://..."
# LINK_BARBEARIA_WEB="https://..."

# --- Distribuição desktop (Windows) ---
# Só preencher depois de gerar e testar o .exe. O SHA-256 é obrigatório.
# LINK_OFICINA_WINDOWS="https://.../vixt-oficina-1.0.0-setup.exe"
# LINK_OFICINA_WINDOWS_SHA256="<64 hex>"
# LINK_OFICINA_WINDOWS_SIZE="<bytes>"
# LINK_BARBEARIA_WINDOWS="https://.../vixt-barbearia-1.0.0-setup.exe"
# LINK_BARBEARIA_WINDOWS_SHA256="<64 hex>"
# LINK_BARBEARIA_WINDOWS_SIZE="<bytes>"

# --- Android (futuro) ---
# ANNOUNCE_ANDROID_COMING_SOON=true   # exibe "Android — Em breve" sem link
# LINK_OFICINA_ANDROID="https://.../vixt-oficina-1.0.0.apk"  (após build real)

# --- Upload de imagens (futuro: S3/R2; Fase 1 usa URLs externas) ---
# STORAGE_DRIVER="local"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Monitoramento (opcional) ---
# SENTRY_DSN=""
